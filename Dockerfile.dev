FROM node:20-alpine

# libc6-compat é recomendado pelo Next.js para Alpine (compatibilidade com binários nativos)
RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package*.json ./

RUN npm ci

# Copia o código fonte para dentro da imagem.
# Quando usado com volume mount (.:/app), o COPY é sobrescrito pelo volume.
# Quando usado sem volume mount (docker-compose.override.yml), o código vem daqui.
COPY . .

EXPOSE 3001

CMD ["npm", "run", "dev"]
